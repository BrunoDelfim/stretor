# ============================================
# Stretor - Variáveis de Ambiente
# ============================================

# --- Aplicação ---
APP_NAME=Stretor
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost

# --- HTTP (Nginx) ---
HTTP_PORT=80

# --- DNS dos containers ---
# O resolver padrão do host (herdado da operadora) costuma bloquear ou devolver
# NXDOMAIN para domínios de tracker, o que faz o indexador parecer "morto".
# Cloudflare e Google resolvem sem filtro. Troque se preferir outro provedor.
# Vale para o Prowlarr e para o FlareSolverr, que resolvem os domínios dos
# trackers por conta própria — o Chromium do FlareSolverr inclusive.
DNS_PRIMARIO=1.1.1.1
DNS_SECUNDARIO=8.8.8.8

# --- Frontend (Vue/Vite) ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost/api
VITE_MEDIA_SERVICE_URL=http://localhost/media
# Porta pública do proxy onde o websocket de recarga (HMR) do Vite conecta.
# No PC local é a 80 (HTTP). No GitHub Codespaces o Space publica cada porta
# encaminhada numa URL HTTPS própria, então o valor precisa ser 443 — o
# post-create do devcontainer ajusta isto sozinho. Sem a variável, o padrão é 80.
VITE_HMR_CLIENT_PORT=80
# Paciência do player com uma fonte. Numa conexão lenta (1 Mbps) o buffer inicial
# do HLS demora mais que os 90 s padrão e uma fonte boa era abandonada no meio do
# preparo. Estique se as fontes estiverem sendo trocadas cedo demais.
VITE_TIMEOUT_FONTE_MS=90000
VITE_ESTAGNACAO_FONTE_MS=20000
# A fonte direta (link MP4/HLS do fallback) não tem peers: o que prova que ela
# está viva é o progresso da conversão. O teto é bem mais largo que o do torrent
# e a estagnação mede o progresso parado, não o relógio. Estique o timeout se a
# conversão de fontes HTTP lentas estiver sendo cortada no meio.
VITE_TIMEOUT_DIRETO_MS=300000
VITE_ESTAGNACAO_DIRETA_MS=60000

# --- Media Service (Node.js + FFmpeg) ---
MEDIA_SERVICE_PORT=3000
# Porta de escuta do WebTorrent. Precisa bater com o mapeamento de portas do
# compose e com o `torrentPort` em `sessoes.js`: é por ela que o container aceita
# conexões de entrada na malha. Uma porta aleatória a cada subida nunca seria
# alcançável de fora, e a fonte apareceria como "sem peers" com muito mais
# frequência do que deveria.
MEDIA_TORRENT_PORT=51413
NODE_ENV=development
# Paciência com fontes de poucos peers. O timeout de dados mede a espera pelo
# primeiro byte, não a velocidade: uma fonte lenta mas viva demora a conectar e
# depois baixa normalmente. Estique se as fontes boas estiverem sendo cortadas.
MEDIA_TIMEOUT_DADOS_MS=30000
MEDIA_TIMEOUT_METADADOS_MS=20000
# Resiliência a fontes de poucos seeds. O prazo de espera por um trecho não é
# mais um relógio fixo: ele só corre enquanto o download estiver parado, e cada
# avanço real de bytes renova a espera. Assim uma fonte lenta mas viva não é
# cortada no meio do caminho.
# Tempo sem nenhum byte novo antes de considerar a fonte estagnada.
MEDIA_ESTAGNACAO_PECAS_MS=90000
# Teto absoluto de espera por um trecho, mesmo com progresso. Evita que uma
# fonte patologicamente lenta prenda a sessão para sempre.
MEDIA_TETO_PECAS_MS=900000
# Abaixo desta contagem de peers a janela de leitura é ampliada, dando ao
# picker mais pedaços elegíveis para pedir a peers vizinhos.
MEDIA_PEERS_ESCASSOS=3
MEDIA_FATOR_JANELA_ESCASSOS=2

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stretor
POSTGRES_USER=stretor
POSTGRES_PASSWORD=secret

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# --- Cache / Queue / Session ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Storage ---
STORAGE_PATH=/app/storage

# --- TMDB (catálogo mundial de filmes) ---
# Obrigatória: chave da API do TMDB usada pelo backend para montar a Home.
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
# Teto de páginas da rolagem infinita da Home (padrão 25, ~500 filmes).
TMDB_MAX_PAGES=25

# --- Prowlarr (indexador Torznab, degrau 2 da busca) ---
# Sobe junto com o stack e é configurado sozinho na primeira subida: o backend
# cadastra os indexadores públicos PT-BR e descobre a chave da API lendo o
# config.xml do volume compartilhado. Não é preciso abrir o painel.
# Painel (opcional, apenas para inspecionar): http://localhost:9696
PROWLARR_PORT=9696
# Endereço interno do Prowlarr usado no provisionamento.
PROWLARR_URL=http://prowlarr:9696
# Caminho do config.xml dentro do container do backend (volume compartilhado).
# Vazio desativa o provisionamento — use quando o Prowlarr for externo.
PROWLARR_CONFIG_PATH=/prowlarr-config/config.xml
# Tempo limite, em segundos, das chamadas de provisionamento (padrão 20).
PROWLARR_TEMPO_LIMITE=20
# Indexadores públicos a cadastrar no Prowlarr, separados por vírgula. Os nomes
# são os identificadores das definições Cardigann (o `definitionFile` sem o
# `.yml`). O 1337x é o histórico; ThePirateBay e TorrentGalaxy entram por terem
# cena PT-BR ("Dublado"/"Dual Áudio") e acesso livre, sem convite.
PROWLARR_INDEXADORES=1337x,thepiratebay,torrentgalaxy
# Subconjunto da lista acima que exige o FlareSolverr por estar atrás do
# CloudFlare. Os demais seguem no caminho direto, sem proxy.
PROWLARR_PROXY_INDEXADORES=1337x,torrentgalaxy

# --- FlareSolverr (proxy para trackers atrás do CloudFlare) ---
# Nível de log do serviço (info, debug, warning...).
FLARESOLVERR_LOG_LEVEL=info
# O Chromium daqui resolve os domínios por conta própria. true o faz consultar
# via DoH, fora do UDP/53 do provedor — o caminho que resta quando o resolver do
# operador bloqueia o tracker e devolve NXDOMAIN ou uma página de bloqueio.
FLARESOLVERR_DNS_OVER_HTTPS=true
# O 1337x e o TorrentGalaxy respondem ao Prowlarr com "blocked by CloudFlare
# Protection": o teste de busca falha, o cadastro é recusado e o indexador fica
# inativo para sempre. O FlareSolverr sobe junto com o stack; o backend o
# cadastra como proxy no Prowlarr e liga esses trackers a ele por tag.
FLARESOLVERR_URL=http://flaresolverr:8191
# false desliga o registro do proxy: os trackers barrados voltam a ficar inativos.
PROWLARR_PROXY_ATIVO=true

# --- SearXNG (motor de busca do fallback de stream direto) ---
# O SearXNG sobe junto com o stack e é consultado só pela rede interna, em
# `http://searxng:8080/search`. Não expõe porta no host: não há instância pública
# envolvida nem IP de container bloqueado por terceiros. A configuração dele
# (saída JSON ligada, limiter desligado) mora em `docker/searxng/settings.yml`.
# Chave usada para assinar as requisições internas. Não é segredo de verdade: o
# serviço só é alcançável pela rede do compose.
SEARXNG_SECRET=stretor_searxng_interno
# Socorro pelo FlareSolverr também na busca nativa (degrau 1). Sem isto, os
# provedores nativos falam HTTP direto e batem de frente no Cloudflare — foi
# assim que o BT4G passou a responder 403 e os trackers PT-BR sumiram. Com isto
# ligado, o ClienteHttp reenvia pelo FlareSolverr o que vier bloqueado.
TORRENTS_PROXY_NATIVO=true
# Teto, em segundos, da chamada ao FlareSolverr na busca nativa.
TORRENTS_PROXY_NATIVO_TIMEOUT=70

# --- Stream direto (fallback MP4/HLS) e estratégia por idade da série ---
# Rede de segurança do conteúdo raro: quando a cascata de torrents não devolve
# nenhuma fonte PT-BR, o backend raspa uma página de streaming e extrai o
# MP4/HLS dela. Paga renderização de navegador (FlareSolverr) por página, por
# isso o padrão do código é `false`; aqui sobe ligado porque é o que cobre as
# séries antigas e novelas que os indexadores já perderam.
TORRENTS_STREAM_DIRETO_HABILITADO=true
# Orçamento próprio do canal direto, em segundos (padrão 45). Não soma ao da
# cascata: cobre as duas renderizações (listagem da série + página do episódio).
TORRENTS_STREAM_DIRETO_ORCAMENTO=45
# Motor de busca do fallback, separado por vírgula. O padrão é o SearXNG interno
# (`searx` → SearXNG; um endereço `brave` exige TORRENTS_STREAM_DIRETO_BRAVE_KEY).
TORRENTS_STREAM_DIRETO_MOTORES=http://searxng:8080/search
# Chave da API oficial do Brave Search. Sem ela, um motor do tipo `brave` é
# descartado antes de qualquer requisição.
TORRENTS_STREAM_DIRETO_BRAVE_KEY=
# Termos extras de busca, separados por vírgula. Vazio deixa o provedor montar
# os termos em camadas a partir do título.
TORRENTS_STREAM_DIRETO_TERMOS=
# Tetos da varredura: termos consultados, páginas abertas e fontes distintas que
# encerram a busca (padrões 5, 6 e 2). Zeros desligam cada corte. O alvo de
# fontes é o que impede o socorro de virar catálogo.
TORRENTS_STREAM_DIRETO_MAX_TERMOS=5
TORRENTS_STREAM_DIRETO_MAX_PAGINAS=6
TORRENTS_STREAM_DIRETO_MAX_FONTES=2
# Teto de tempo, em segundos, por página (padrão 8).
TORRENTS_STREAM_DIRETO_TEMPO_LIMITE=8
# Janela, em milissegundos, do atraso sorteado entre consultas ao motor
# (padrão 400-1200). É a cadência humana que evita o rate limit.
TORRENTS_STREAM_DIRETO_INTERVALO_MIN=400
TORRENTS_STREAM_DIRETO_INTERVALO_MAX=1200
# Relevância mínima: quantas palavras-chave do título a página precisa carregar
# (padrão 2). Zero desliga a checagem e volta a aceitar só pela prova de mídia.
TORRENTS_STREAM_DIRETO_MIN_PALAVRAS_CHAVE=2
# Barreira de conteúdo impróprio: domínio adulto ou palavra-chave imprópria é
# descartado antes de a página ser aberta (padrão true).
TORRENTS_STREAM_DIRETO_FILTRO_ADULTO=true
# Busca direta nos agregadores de vídeo, antes do motor web (padrão true). O
# atalho contorna o motor aberto — que devolve só plataforma legal quando os
# motores grandes estão suspensos — perguntando direto à busca interna dos
# agregadores. As páginas que voltam passam pelo mesmo crivo (relevância, prova
# de mídia, extração) das que vêm do motor.
TORRENTS_STREAM_DIRETO_BUSCA_DIRETA=true

# Estratégia por idade da série. Recente (dentro do limiar) começa pelos
# torrents, com o stream direto de fallback cruzado; antiga começa pelo stream
# direto, com o orçamento inteiro e sem cruzamento. Sem ano no catálogo, vale o
# fluxo normal (torrents, que respondem por imdb_id).
TORRENTS_BUSCA_POR_IDADE_HABILITADA=true
# Limiar, em anos, que separa recente de antiga (padrão 2, inclusivo: com 2, uma
# série de dois anos ainda é recente e uma de três já é antiga). Zero ou negativo
# desliga o corte na prática.
TORRENTS_BUSCA_IDADE_LIMITE_ANOS=2

PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# --- Torrents (busca de fontes para reprodução) ---
# A busca acontece em três degraus, e cada um só entra quando o anterior não
# devolve fonte dublada válida:
#   1) busca nativa do backend (trackers PT-BR + APIBay + Knaben + Torrentio + addons Stremio + BT4G)
#   2) indexador Torznab (Prowlarr) — configurado automaticamente na subida
#   3) YTS (reserva em inglês)
# Nada aqui é obrigatório: faltando uma chave ou um serviço, o degrau é pulado.
# Idiomas pedidos ao Torrentio (busca por imdb_id), separados por vírgula.
# Sem isto, o Torrentio responde com o catálogo padrão — quase todo em inglês —
# e a série não traz fonte dublada.
TORRENTS_TORRENTIO_IDIOMAS=portuguese
# Segunda consulta ao Torrentio, sem o filtro de idioma, quando a busca é de
# série. O filtro da URL é um corte na origem: ele derruba o pack que não se
# declara dublado e nos deixa só com o que já veio etiquetado. A consulta extra
# roda sem filtro apenas para enxergar esses packs; quem decide o idioma de
# verdade é o parser interno, que lê o nome do release. Filmes não pagam esse
# custo — seguem só com o filtro. Padrão true.
TORRENTS_TORRENTIO_BUSCA_AMPLA=true
# Trackers públicos PT-BR consultados direto por HTTP, separados por vírgula.
# Em branco de propósito: os dois domínios antigos morreram (um sequestrado, o
# outro sem DNS). Lista vazia pula o provedor; preencha com um domínio vivo.
TORRENTS_TRACKERS_BR_URLS=
# Caminho da página de busca dentro desses trackers.
TORRENTS_TRACKERS_BR_BUSCA=index.php
# API pública do Pirate Bay (JSON, com campo imdb).
TORRENTS_APIBAY_URL=https://apibay.org
# Torrentio: busca por imdb_id.
TORRENTS_TORRENTIO_URL=https://torrentio.strem.fun
# Metabuscador DHT, espelhos separados por vírgula.
TORRENTS_BT4G_URLS=https://bt4gprx.com
# Teto de páginas de detalhe abertas em paralelo por busca (padrão 16).
TORRENTS_MAX_DETALHES_BUSCA=16
# Tempo limite, em segundos, de cada requisição a um provedor (padrão 15).
TORRENTS_TEMPO_LIMITE=15
# Teto próprio do BT4G e do APIBay, que varrem o acervo mundial e são os mais
# lentos da cascata. Curto de propósito: eles não podem segurar a rodada de
# abertura sozinhos, senão os provedores por identificador ficam sem orçamento.
TORRENTS_ACERVO_MUNDIAL_TEMPO_LIMITE=8
# Alguns trackers recusam cliente sem User-Agent de navegador.
TORRENTS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
TORRENTS_TORZNAB_URL=http://prowlarr:9696
# Opcional: em branco, o backend usa a chave que ele mesmo descobre no Prowlarr.
# Preencha apenas para apontar a um Prowlarr externo.
TORRENTS_TORZNAB_KEY=
# Categoria Torznab de filmes (2000 = Movies).
TORRENTS_TORZNAB_CATEGORIA=2000
# Categoria Torznab de séries (5000 = TV). Separada da de filmes porque o
# Prowlarr filtra por categoria: pedir um episódio com a categoria de filme
# devolve zero resultados, mesmo com o release indexado.
TORRENTS_TORZNAB_CATEGORIA_SERIE=5000
# Orçamento de tempo, em segundos, para a busca inteira — os três degraus
# somados. Cada degrau tinha o seu teto, mas os tetos não conversavam: um
# provedor bloqueado custa a tentativa direta mais o socorro pelo FlareSolverr, e
# isso se repete a cada termo do episódio. Como a cascata é sequencial, o pior
# caso é a soma de tudo, e essa soma não tinha limite — o /fontes passava dos 60s
# que o frontend espera e a requisição era cancelada. Ao estourar, a busca para
# onde está e devolve o que já recolheu. É o teto que manda; os orçamentos por
# degrau abaixo só apertam dentro dele.
TORRENTS_ORCAMENTO_BUSCA=45
# Orçamento de tempo, em segundos, para o degrau do indexador em uma busca. O
# degrau varre os indexadores em série e um deles responde pelo FlareSolverr, com
# vários segundos por consulta: sem teto, o /fontes de um episódio ultrapassa os
# 60s que o frontend espera e a requisição é cancelada. Ao estourar, o degrau
# devolve o que já recolheu em vez de não devolver nada. Com a cobertura completa
# ligada o degrau é sempre visitado, então o teto precisa ser curto.
TORRENTS_TORZNAB_ORCAMENTO=8

# Reserva: provedor YTS consultado quando o indexador não está configurado.
# Use o espelho yts.gg: o domínio yts.mx é bloqueado por DNS em muitos hosts.
TORRENTS_BASE_URL=https://yts.gg
# Tempo de cache da busca de fontes, em segundos (padrão 1800).
TORRENTS_CACHE_TTL=1800
# Ignora a leitura do cache das consultas externas (Torrentio, Knaben, BT4G,
# APIBay e Torznab) durante a busca. Não desliga o cache: a consulta é refeita e
# o resultado novo volta a ser gravado. Serve para desalojar um resultado
# limitado que ficou preso até o TTL vencer — a lista de fontes de uma série
# antiga pode ter sido montada quando os termos de busca eram restritos.
# Padrão false; ligue só pontualmente.
TORRENTS_CACHE_BYPASS=false
# Concentra a lista na pilha boa — dublado e dual áudio provados. Com o corte
# duro ligado, a lista final é só ela, cortada no teto de LIMITE_FONTES (4), sem
# preenchimento com reserva: quando as PT-BR acabam, a lista para. A reserva
# (legendado, original e pack de idioma não provado) só entra quando não há
# nenhuma fonte PT-BR. Deixe true enquanto o player só reproduz áudio em PT-BR.
TORRENTS_APENAS_PT_BR=true
# Corte duro de idioma da lista final. Com isto ligado, só o áudio PT-BR provado
# sobrevive: dublado e dual áudio. O original em inglês e o legendado (áudio
# original com legenda PT-BR) saem de vez, mesmo que a lista fique abaixo do
# teto. Desligue para trazer a reserva de volta ao fim da lista.
TORRENTS_SOMENTE_PT_BR_OU_LEGENDADO=true
# Busca de packs de temporada ("Temporada 1 completa", "S01 completa") quando os
# termos de episódio não acham fonte dublada. É o que destrava séries antigas: o
# pack tem seeds onde o episódio isolado já morreu, e o media-service baixa só o
# arquivo do episódio pedido de dentro do pacote. false desliga a frente sem
# mexer no restante da cascata.
TORRENTS_PACKS_HABILITADOS=true
# Exceção de idioma só para pack. O pack de série antiga quase nunca vem marcado
# como dublado; sem isto ele é achado e descartado, e a lista volta vazia. Com
# true, só a fonte marcada como pack segue sem PT-BR provado — e ainda assim ela
# entra na reserva, no fim da lista, depois dos episódios de qualquer idioma.
# Episódios e filmes seguem a regra normal. false restaura o comportamento
# anterior.
TORRENTS_PACKS_QUALQUER_IDIOMA=true
# Termos de série ("... dublado", "... temporada 1"), tentados por último, sem
# numeração de episódio e sem "completa". É o que faz o buscador casar o nome do
# pack multi-temporada das séries antigas ("1ª 2ª 3ª Temporadas Dublado"), que os
# termos de episódio e de pack não alcançam. As fontes que vêm deles passam pelo
# gate de temporada: quem não declara a temporada pedida é descartado. false
# desliga a frente sem mexer no restante da cascata.
TORRENTS_TERMOS_SERIE_HABILITADO=true

# Piso de fontes boas (dublado e dual áudio provados) que dispensa a reserva
# (padrão 15). Com o corte duro de idioma ligado, a lista final é só a pilha boa
# até o teto de LIMITE_FONTES (4), sem preenchimento com reserva; a reserva só
# entra quando a pilha boa está vazia.
TORRENTS_MINIMO_FONTES=15
# Meta de fontes PT-BR que a coleta tenta juntar antes de parar de varrer os
# termos e degraus. O que passar disso vira reserva.
TORRENTS_META_PT_BR=6
# Cobertura completa: com a meta PT-BR já batida, ainda desce os degraus
# restantes (indexador e YTS) para consultar todos os provedores ao menos uma vez
# — é o que o relatório de cobertura mostra como prova. Custa latência; deixe
# false no fluxo comum e ligue quando precisar de certeza.
TORRENTS_COBERTURA_COMPLETA=false
# Buscar em todos os provedores, sem encerrar na primeira meta atingida. Ligado
# (padrão), a cascata percorre o registro inteiro: cada provedor recebe os termos
# até render TORRENTS_FONTES_SUFICIENTES_POR_PROVEDOR fontes e então é deixado de
# lado — não por ter falhado, mas por já ter dado o que tinha —, e a busca segue
# para o próximo. Quem não tem fonte ou está indisponível é pulado na hora. O
# preço é a latência: o orçamento global passa a ser o único freio.
TORRENTS_BUSCAR_TODOS=true
# Quantas fontes aproveitadas um provedor precisa somar para parar de ser
# consultado nos termos seguintes. Zero desliga o corte e a busca volta a varrer
# todos os termos em todos os degraus.
TORRENTS_FONTES_SUFICIENTES_POR_PROVEDOR=4
# Quantos packs podem ter o conteúdo aberto no media-service numa busca, quando
# o nome do pack não prova o idioma. A inspeção é cara: tem teto curto de tempo
# e cache por infohash.
TORRENTS_INSPECAO_PACKS_LIMITE=6
# Tempo limite, em segundos, da inspeção de um pack (padrão 12).
TORRENTS_INSPECAO_TIMEOUT=12
# Tempo de cache do veredito da inspeção, em segundos (padrão 86400 = 24h).
TORRENTS_INSPECAO_CACHE_TTL=86400

# --- Fase 2B: Knaben e addons Stremio hospedados (degrau 1) ---
# O Knaben é um metabuscador com API JSON própria. É ele quem enxerga os packs
# PT-BR que os trackers nativos e o Torrentio não acham — o socorro das séries
# antigas. A busca por nome só funciona com search_type "100%": o modo "score"
# ignora a query e devolve o topo global (resultado inútil).
TORRENTS_KNABEN_HABILITADO=true
TORRENTS_KNABEN_URL=https://api.knaben.org/v1
# Teto de resultados pedidos por termo (padrão 20).
TORRENTS_KNABEN_LIMITE=20
# Addons Stremio hospedados, consultados por imdb_id, no mesmo protocolo do
# Torrentio. Cada base vira /stream/series/{imdb}:{temporada}:{episodio}.json
# (ou /stream/movie/{imdb}.json). Espelhos separados por vírgula.
TORRENTS_STREMIO_ADDONS=https://thepiratebay-plus.strem.fun
