APP_NAME=Stretor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=stretor
DB_USERNAME=stretor
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=stretor

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEDIA_SERVICE_URL=http://media-service:3000

# --- TMDB (catálogo mundial de filmes) ---
# Obrigatória: sem esta chave a Home não consegue carregar os filmes.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
TMDB_CACHE_TTL=3600
# Teto de páginas da rolagem infinita da Home (padrão 25, ~500 filmes).
TMDB_MAX_PAGES=25

# --- Torrents (busca de fontes para reprodução) ---
# A busca acontece em três degraus, e cada um só entra quando o anterior não
# devolve fonte dublada válida:
#   1) busca nativa do backend (trackers públicos PT-BR + APIBay + Torrentio + BT4G)
#   2) indexador Torznab (Prowlarr)
#   3) YTS (reserva em inglês)
# Tudo aqui é opcional: faltando uma chave ou um serviço, o degrau é pulado e a
# busca continua no degrau seguinte.

# --- Degrau 1: busca nativa no backend (sem chave) ---
# Trackers públicos PT-BR consultados direto por HTTP, separados por vírgula.
# Em branco de propósito: os dois domínios antigos morreram (um sequestrado, o
# outro sem DNS). Lista vazia pula o provedor; preencha com um domínio vivo.
TORRENTS_TRACKERS_BR_URLS=
# Caminho da página de busca dentro desses trackers.
TORRENTS_TRACKERS_BR_BUSCA=index.php
# API pública do Pirate Bay (JSON, com campo imdb).
TORRENTS_APIBAY_URL=https://apibay.org
# Torrentio: busca por imdb_id.
TORRENTS_TORRENTIO_URL=https://torrentio.strem.fun
# Idiomas pedidos ao Torrentio, separados por vírgula. Sem isto, ele responde
# com o catálogo padrão (quase todo em inglês) e a série não traz dublado.
TORRENTS_TORRENTIO_IDIOMAS=portuguese
# Metabuscador DHT, espelhos separados por vírgula.
TORRENTS_BT4G_URLS=https://bt4gprx.com
# Teto de páginas de detalhe abertas em paralelo por busca (padrão 16).
TORRENTS_MAX_DETALHES_BUSCA=16
# Tempo limite, em segundos, de cada requisição a um provedor (padrão 15).
TORRENTS_TEMPO_LIMITE=15
# Alguns trackers recusam cliente sem User-Agent de navegador.
TORRENTS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"

# --- Degrau 2: indexador Torznab (Prowlarr) ---
# O Prowlarr é provisionado sozinho na subida do stack: o entrypoint do backend
# chama `php artisan prowlarr:provisionar`, que cadastra os indexadores públicos
# PT-BR e grava a chave da API aqui. Sem chave, o degrau é pulado e a busca
# desce para o YTS.
TORRENTS_TORZNAB_URL=http://prowlarr:9696
# Normalmente vazio: preenchido automaticamente na subida.
TORRENTS_TORZNAB_KEY=
# Categoria Torznab de filmes (2000 = Movies).
TORRENTS_TORZNAB_CATEGORIA=2000
# Categoria Torznab de séries (5000 = TV). Separada da de filmes porque o
# Prowlarr filtra por categoria: pedir um episódio com a categoria de filme
# devolve zero resultados, mesmo com o release indexado.
TORRENTS_TORZNAB_CATEGORIA_SERIE=5000

# --- Provisionamento automático do Prowlarr ---
# Endereço interno do Prowlarr (o mesmo informado no Torznab acima).
PROWLARR_URL=http://prowlarr:9696
# Caminho do config.xml dentro do container do backend (volume compartilhado).
# Vazio desativa o provisionamento — use quando o Prowlarr for externo.
PROWLARR_CONFIG_PATH=/prowlarr-config/config.xml
# Tempo limite, em segundos, das chamadas de provisionamento (padrão 20).
PROWLARR_TEMPO_LIMITE=20
# Endereço interno do FlareSolverr. O backend o cadastra como proxy no Prowlarr
# e o associa aos trackers que o CloudFlare barra (hoje, o 1337x) — sem isso o
# cadastro é recusado e o indexador nunca sai de inativo.
FLARESOLVERR_URL=http://flaresolverr:8191
# false pula o registro do proxy; o 1337x fica cadastrado, porém inativo.
PROWLARR_PROXY_ATIVO=true

# --- Degrau 3: YTS (reserva em inglês) ---
# O domínio yts.mx costuma ser bloqueado por DNS em servidores de hospedagem;
# yts.gg é o espelho estável.
TORRENTS_BASE_URL=https://yts.gg
# Tempo de cache da busca de fontes, em segundos (padrão 1800).
TORRENTS_CACHE_TTL=1800
# Enquanto o player só reproduz áudio em PT-BR, descarta da lista tudo que não
# seja dublado ou dual áudio. Deixe true para o teste ficar rápido; mude para
# false quando legendado e idioma original forem suportados.
TORRENTS_APENAS_PT_BR=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@stretor.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173
