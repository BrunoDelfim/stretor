.aider*
# ============================================
# Stretor - .gitignore
# ============================================

# --- Dependências ---
node_modules/
vendor/
bower_components/

# --- Ambiente ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log.*

# --- Build / Dist ---
dist/
build/
public/build/
public/hot
public/storage
storage/*.key
*.tsbuildinfo

# --- Laravel ---
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
.phpunit.result.cache
.phpunit.cache/
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log

# --- Vue / Vite ---
.vite/
.vite-cache/
coverage/

# --- Media Service ---
media-service/storage/*
!media-service/storage/.gitkeep
media-service/tmp/*
!media-service/tmp/.gitkeep

# --- Artefatos de runtime do Laravel ---
# Arquivos temporários que o backend cria em execução (ex.: unpack.php).
/backend/storage/app/*
!/backend/storage/app/.gitkeep

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- GitHub Codespaces ---
# A configuração do devcontainer é versionada de propósito: é ela que faz o
# Space subir o sistema inteiro sozinho. Só o estado local do Space é ignorado.
.devcontainer/.env

# --- Docker ---
docker-compose.override.yml

# --- Sentinelas de bootstrap ---
# Marcam que o bootstrap/migrations já rodaram; são estado local, não código.
.bootstrap-done
backend/storage/framework/.migrations-done

# --- Planejamento ---
# Documentos de planejamento/arquitetura ficam fora do versionamento.
plans/

# --- Outros ---
*.cache
.cache/
