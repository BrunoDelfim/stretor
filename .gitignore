.aider*
# ============================================
# Stretor - .gitignore
# ============================================

# --- Dependências ---
node_modules/
vendor/
bower_components/

# --- Ambiente ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log.*

# --- Build / Dist ---
dist/
build/
public/build/
public/hot
public/storage
storage/*.key
*.tsbuildinfo

# --- Laravel ---
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
.phpunit.result.cache
.phpunit.cache/
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log

# --- Vue / Vite ---
.vite/
.vite-cache/
coverage/

# --- Media Service ---
media-service/storage/*
!media-service/storage/.gitkeep
media-service/tmp/*
!media-service/tmp/.gitkeep

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- Outros ---
*.cache
.cache/
